@model NotificacionesViewModel
@{ ViewData["Title"] = "Notificaciones"; }
<div class="section-head"><div><h3>Notificaciones</h3><p>Avisos importantes sobre tu actividad.</p></div></div>
<div class="list">
    @foreach (var item in Model.Notificaciones.OrderByDescending(x => x.FechaEnvio))
    {
        <article class="list-card @(!item.Leida ? "unread" : "")">
            <div><h4>@item.TipoEvento</h4><p>@item.Mensaje</p><small>@item.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</small></div>
            @if (!item.Leida)
            {
                <form asp-action="MarcarLeida" method="post">
                    <input type="hidden" name="Id" value="@item.Id" />
                    <input type="hidden" name="Pagina" value="@Model.Pagina" />
                    <button class="card-button button-success" type="submit">✓ Marcar leída</button>
                </form>
            }
        </article>
    }
</div>
@if (Model.Notificaciones.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel
        {
            Title = "No hay notificaciones",
            Message = "Estás al día."
        })" />
}
<nav class="pagination">
    @if (Model.Pagina > 1) { <a class="card-button" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a> }
    <span>Página @Model.Pagina</span>
    @if (Model.HayPaginaSiguiente) { <a class="card-button" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a> }
</nav>
