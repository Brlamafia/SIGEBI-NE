@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="panel service-error" role="alert">
    <span class="eyebrow">Error inesperado</span>
    <h3>No pudimos completar la operación</h3>
    <p>Ocurrió un inconveniente al procesar la solicitud. Inténtalo nuevamente.</p>
    <a class="card-button button-add" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    @if (Model.ShowRequestId)
    {
        <small>Referencia: @Model.RequestId</small>
    }
</section>
