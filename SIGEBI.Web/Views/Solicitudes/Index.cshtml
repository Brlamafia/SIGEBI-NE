@model SolicitudesViewModel
@{ ViewData["Title"] = "Solicitudes"; }
<div class="section-head">
    <div><h3>Mis solicitudes</h3><p>Seguimiento de las solicitudes de préstamo.</p></div>
    <a class="card-button button-add" asp-controller="Catalogo" asp-action="Index"><span>＋</span>Nueva solicitud</a>
</div>
<div class="list">
    @foreach (var item in Model.Solicitudes.OrderByDescending(x => x.FechaSolicitud))
    {
        <article class="list-card">
            <div>
                <h4>@(Model.TitulosLibros.GetValueOrDefault(item.LibroId, $"Libro #{item.LibroId}"))</h4>
                <p>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</p>
                <small>Solicitud #@item.Id</small>
                @if (!string.IsNullOrWhiteSpace(item.MotivoRechazo)) { <small>@item.MotivoRechazo</small> }
            </div>
            <div class="item-actions">
                <span class="pill @item.Estado">@item.Estado</span>
                @if (item.Estado == "Pendiente")
                {
                    <form asp-action="Cancelar"
                          method="post"
                          data-confirm="¿Deseas cancelar la solicitud de '@(Model.TitulosLibros.GetValueOrDefault(item.LibroId, $"Libro #{item.LibroId}"))'? Esta acción no se puede deshacer.">
                        <input type="hidden" name="Id" value="@item.Id" />
                        <button class="card-button button-danger" type="submit">Cancelar solicitud</button>
                    </form>
                }
            </div>
        </article>
    }
</div>
@if (Model.Solicitudes.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel
        {
            Title = "No tienes solicitudes",
            Message = "Visita el catálogo para solicitar un libro.",
            ActionText = "Explorar catálogo",
            ActionController = "Catalogo"
        })" />
}
