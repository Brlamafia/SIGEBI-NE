@model ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; }
<div class="auth-single auth-blue">
    <section class="auth-card">
        <span class="eyebrow">Seguridad</span>
        <h1>Crea una nueva contraseña</h1>
        <p>Debe contener al menos ocho caracteres, una mayúscula, una minúscula y un número.</p>
        <form asp-action="ResetPassword" method="post">
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            <button class="primary-button" type="submit"><span>Guardar contraseña</span><span>→</span></button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
