@model RegisterViewModel
@{ ViewData["Title"] = "Crear cuenta"; }
<div class="auth-single auth-blue">
    <section class="auth-card auth-card-wide">
        <a class="auth-back" asp-action="Login">← Volver al acceso</a>
        <span class="eyebrow">Nuevo lector</span>
        <h1>Crea tu cuenta</h1>
        <p>Selecciona tu perfil institucional para aplicar correctamente las condiciones de préstamo.</p>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <fieldset class="reader-type-fieldset">
                <legend>¿Cómo deseas registrarte?</legend>
                <div class="reader-type-selector">
                    <label class="reader-type-option">
                        <input asp-for="TipoUsuario" type="radio" value="Estudiante" />
                        <span class="reader-type-icon" aria-hidden="true">E</span>
                        <span>
                            <strong>Estudiante</strong>
                            <small>Hasta 3 préstamos · 7 días</small>
                        </span>
                    </label>
                    <label class="reader-type-option">
                        <input asp-for="TipoUsuario" type="radio" value="Docente" />
                        <span class="reader-type-icon" aria-hidden="true">D</span>
                        <span>
                            <strong>Docente</strong>
                            <small>Hasta 5 préstamos · 14 días</small>
                        </span>
                    </label>
                </div>
                <span asp-validation-for="TipoUsuario" class="field-error"></span>
            </fieldset>
            <div class="auth-form-grid">
                <div><label asp-for="Nombre"></label><input asp-for="Nombre" /><span asp-validation-for="Nombre" class="field-error"></span></div>
                <div><label asp-for="Apellido"></label><input asp-for="Apellido" /><span asp-validation-for="Apellido" class="field-error"></span></div>
                <div><label asp-for="Cedula"></label><input asp-for="Cedula" /><span asp-validation-for="Cedula" class="field-error"></span></div>
                <div><label asp-for="Telefono"></label><input asp-for="Telefono" /><span asp-validation-for="Telefono" class="field-error"></span></div>
                <div class="full-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div>
                <div><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password" class="field-error"></span></div>
                <div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
            </div>
            <button class="primary-button" type="submit"><span>Crear mi cuenta</span><span>→</span></button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
