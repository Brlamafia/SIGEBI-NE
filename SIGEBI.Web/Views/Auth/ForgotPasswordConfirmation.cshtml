@{ ViewData["Title"] = "Solicitud recibida"; }
<div class="auth-single auth-blue">
    <section class="auth-card">
        <span class="auth-success-icon">✓</span>
        <span class="eyebrow">Solicitud recibida</span>
        <h1>Revisa tu correo</h1>
        <p>Si existe una cuenta asociada, recibirás las instrucciones para restablecer tu contraseña.</p>
        @if (ViewData["DevelopmentResetUrl"] is string resetUrl)
        {
            <div class="development-link">
                <strong>Modo desarrollo</strong>
                <p>SMTP no está habilitado o no pudo completar el envío. Utiliza este enlace local para probar el flujo:</p>
                <a href="@resetUrl">Restablecer contraseña</a>
            </div>
        }
        <a class="primary-button" asp-action="Login"><span>Volver al acceso</span><span>→</span></a>
    </section>
</div>
