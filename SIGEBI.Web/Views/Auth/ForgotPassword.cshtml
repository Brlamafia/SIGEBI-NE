@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Recuperar contraseña"; }
<div class="auth-single auth-blue">
    <section class="auth-card">
        <a class="auth-back" asp-action="Login">← Volver al acceso</a>
        <span class="eyebrow">Recuperación</span>
        <h1>¿Olvidaste tu contraseña?</h1>
        <p>Escribe el correo asociado a tu cuenta y generaremos un enlace temporal.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
            <button class="primary-button" type="submit"><span>Continuar</span><span>→</span></button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
