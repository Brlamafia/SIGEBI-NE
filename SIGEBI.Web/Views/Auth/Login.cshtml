@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="login-shell auth-blue">
    <section class="login-brand">
        <img class="login-brand-logo"
             src="~/images/ne-library-logo.png"
             asp-append-version="true"
             alt="NE Library" />
        <div>
            <span class="eyebrow">Librería Nueva Era</span>
            <h1>Tu próxima historia comienza aquí.</h1>
            <p>Consulta el catálogo, solicita tus libros y administra toda tu actividad bibliotecaria desde SIGEBI.</p>
        </div>
        <div class="quote-card"><span>“</span><p>Leer es encontrar una puerta donde antes había una pared.</p><small>SIGEBI · Nueva Era</small></div>
    </section>
    <section class="login-panel">
        <div class="login-form">
            <div class="mobile-brand">
                <img src="~/images/ne-library-logo.png" asp-append-version="true" alt="NE Library" />
            </div>
            <span class="eyebrow">Bienvenido</span>
            <h2>Inicia sesión</h2>
            <p>Accede con tu correo o utiliza tu cuenta de Google.</p>

            @if (Model.GoogleEnabled)
            {
                <a class="google-button" asp-action="GoogleLogin" asp-route-returnUrl="@Model.ReturnUrl">
                    <span class="google-mark">G</span>
                    Continuar con Google
                </a>
            }
            else
            {
                <button class="google-button" type="button" disabled title="Google OAuth todavía no está configurado">
                    <span class="google-mark">G</span>
                    Continuar con Google
                </button>
            }

            <div class="auth-divider"><span>o continúa con tu correo</span></div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="form-error"></div>
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" />
                <span asp-validation-for="Email" class="field-error"></span>
                <div class="label-row">
                    <label asp-for="Password"></label>
                    <a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
                </div>
                <div class="password-wrap">
                    <input asp-for="Password" autocomplete="current-password" />
                    <button class="text-button" data-password-toggle type="button">Mostrar</button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
                <label class="check-label"><input asp-for="Recordarme" /> @Html.DisplayNameFor(m => m.Recordarme)</label>
                <button class="primary-button" type="submit"><span>Entrar</span><span>→</span></button>
            </form>
            <p class="auth-switch">¿Aún no tienes una cuenta? <a asp-action="Register">Crear cuenta</a></p>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
