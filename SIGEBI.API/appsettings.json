{
  "Logging": {
    "FileDirectory": "logs",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jobs": {
    "PrestamosVencidos": {
      "Habilitado": true,
      "IntervaloMinutos": 60,
      "UsuarioResponsableId": 1
    }
  },
  "Jwt": {
    "Issuer": "SIGEBI.API",
    "Audience": "SIGEBI.Clients"
  },
  "Authentication": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "WebClientSecret": "",
    "PasswordResetAllowedOrigins": [
      "https://localhost:7030",
      "http://localhost:5065"
    ]
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "FromEmail": "",
    "FromName": "SIGEBI Nueva Era"
  },
  "PoliticasPrestamo": {
    "MontoMultaPorDia": 50,
    "MontoMultaPorDanio": 500,
    "MontoMultaPorPerdida": 1500,
    "DiasAnticipacionRecordatorio": 2,
    "Condiciones": {
      "Estudiante": {
        "LimitePrestamos": 3,
        "DiasPrestamo": 7
      },
      "Docente": {
        "LimitePrestamos": 5,
        "DiasPrestamo": 14
      },
      "Administrativo": {
        "LimitePrestamos": 3,
        "DiasPrestamo": 7
      },
      "Externo": {
        "LimitePrestamos": 1,
        "DiasPrestamo": 3
      }
    }
  },
  "AllowedHosts": "*"
}
