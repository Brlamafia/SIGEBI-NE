{
  "Logging": {
    "FileDirectory": "logs",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jobs": {
    "PrestamosVencidos": {
      "Habilitado": true,
      "IntervaloMinutos": 60,
      "UsuarioResponsableId": 1
    }
  },
  "PoliticasPrestamo": {
    "MontoMultaPorDia": 50,
    "MontoMultaPorDanio": 500,
    "MontoMultaPorPerdida": 1500,
    "DiasAnticipacionRecordatorio": 2,
    "Condiciones": {
      "Estudiante": {
        "LimitePrestamos": 3,
        "DiasPrestamo": 7
      },
      "Docente": {
        "LimitePrestamos": 5,
        "DiasPrestamo": 14
      },
      "Administrativo": {
        "LimitePrestamos": 3,
        "DiasPrestamo": 7
      },
      "Externo": {
        "LimitePrestamos": 1,
        "DiasPrestamo": 3
      }
    }
  },
  "AllowedHosts": "*"
}
